# Required for Scova v2 backend. Copy to .env and fill in values.
# Do not commit .env.

OPENROUTER_API_KEY=your_openrouter_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional: leave empty if using new Supabase JWT signing keys (ECC). Only needed for legacy HS256 local verification.
SUPABASE_JWT_SECRET=

# Optional: for local dev only. When set, frontend calls Python backend directly (avoids Next.js proxy timeout).
# Copy to .env.local and set: NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=
